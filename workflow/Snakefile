# Minigraph-Cactus pangenome for Trifolium repens.
# Run from repo root:
#   snakemake -s workflow/Snakefile --directory workflow --cores 4 -p

from pathlib import Path

configfile: "../config/config.yaml"
include: "rules/common.smk"

REFS = Path(config["refs_dir"])
INDEX_DONE = config["index_done_flag"]
LOG = config.get("logs_dir", "/scratch/odrew060/Trep_pangenome/pangenome_logs")
DONE = config.get("done_flag", "/scratch/odrew060/Trep_pangenome/pangenome.done")
OUT = Path(config["output_dir"])
USE_HAP_SUBDIR = config.get("refs_use_haplotype_subdir", False)

PG = config["pangenome"]
NAME = PG["out_name"]
CACTUS_ACTIVATE = PG.get("cactus_activate", "")
# Repo root (parent of workflow/). Do not use __file__ — breaks under --directory workflow.
REPO_ROOT = Path(workflow.basedir).parent
CACTUS_SCRIPT = str(REPO_ROOT / "scripts" / "run_cactus_pangenome.sh")
CONTAINER = PG.get("container", "")
BIND_FLAGS = " ".join(
    f"-B {p}:{p}"
    for p in PG.get(
        "container_bind",
        ["/scratch/odrew060", "/home/uottawa.o.univ/odrew060"],
    )
)

INDEX_BY_ID = {
    r["row_id"]: r
    for r in load_samples(config["index_samples_csv"])
    if r.get("file_type") == "genome"
}
PG_ROWS = [r for r in load_samples(config["pangenome_samples_csv"]) if enabled(r)]
GENOMES = []
for pr in PG_ROWS:
    idx = INDEX_BY_ID[pr["row_id"]]
    GENOMES.append(
        {
            **idx,
            "cactus_name": pr["cactus_name"],
            "results_subdir": pr.get("results_subdir") or idx.get("haplotype"),
        }
    )
GENOME_BY_CACTUS = {r["cactus_name"]: r for r in GENOMES}

ASM = lambda r: Path(r["file"].replace(".gz", "")).stem


def ref_path(r):
    base = REFS / r["source"]
    if USE_HAP_SUBDIR:
        base = base / r["results_subdir"]
    return base / f"{ASM(r)}.fna"


def write_sanitized_fasta(src: Path, dst: Path) -> None:
    """Cactus requires ACGTN only; convert IUPAC ambiguity codes (e.g. k) to N."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    with open(src) as inf, open(dst, "w") as outf:
        for line in inf:
            if line.startswith(">"):
                outf.write(line)
            else:
                s = line.strip()
                outf.write("".join(c if c.upper() in "ACGTN" else "N" for c in s) + "\n")


RES = OUT / config.get("results_dir", "results")
SAN_DIR = RES / "sanitized_fna"
WRK = OUT / config.get("work_dir", "work")
SEQFILE = RES / "seqfile.txt"
PGD = RES / NAME
JOBSTORE = WRK / "jobstore"
WORK = WRK / "scratch"


rule all:
    input:
        DONE,


rule make_seqfile:
    input:
        index_done=INDEX_DONE,
    output:
        seqfile=str(SEQFILE),
    log:
        f"{LOG}/make_seqfile/seqfile.log",
    run:
        Path(log[0]).parent.mkdir(parents=True, exist_ok=True)
        if PG["reference"] not in GENOME_BY_CACTUS:
            raise ValueError(f"reference '{PG['reference']}' not in enabled pangenome_genomes.csv")
        if missing := [str(ref_path(r)) for r in GENOMES if not ref_path(r).is_file()]:
            raise ValueError(
                "Missing indexed .fna under refs_dir (finish index_Trep_refs first):\n"
                + "\n".join(missing)
            )
        Path(output.seqfile).parent.mkdir(parents=True, exist_ok=True)
        with open(output.seqfile, "w") as out, open(log[0], "w") as lf:
            for r in GENOMES:
                src = ref_path(r)
                dst = SAN_DIR / f"{r['cactus_name']}.fna"
                write_sanitized_fasta(src, dst)
                line = f"{r['cactus_name']}\t{dst}\n"
                out.write(line)
                lf.write(f"{line}(from {src})\n")


rule cactus_pangenome:
    input:
        seqfile=rules.make_seqfile.output.seqfile,
    output:
        gbz=f"{PGD}/{NAME}.full.gbz",
        gfa=f"{PGD}/{NAME}.full.gfa.gz",
        vcf=f"{PGD}/{NAME}.d2.vcf.gz",
        hal=f"{PGD}/{NAME}.hal",
        dist=f"{PGD}/{NAME}.d2.dist",
        min=f"{PGD}/{NAME}.d2.min",
    log:
        f"{LOG}/cactus_pangenome/{NAME}.log",
    resources:
        mem_mb=PG.get("mem_mb", 128000),
        runtime=PG.get("runtime", 2880),
    run:
        import shlex
        import subprocess

        PGD.mkdir(parents=True, exist_ok=True)
        WORK.mkdir(parents=True, exist_ok=True)
        Path(log[0]).parent.mkdir(parents=True, exist_ok=True)
        if not Path(CACTUS_SCRIPT).is_file():
            raise FileNotFoundError(f"Missing {CACTUS_SCRIPT} — git pull or copy scripts/run_cactus_pangenome.sh")
        cmd = [
            "bash",
            CACTUS_SCRIPT,
            str(JOBSTORE),
            str(input.seqfile),
            str(PGD),
            NAME,
            PG["reference"],
            PG["batch_system"],
            str(WORK),
            log[0],
            str(PG["mg_cores"]),
            str(PG["map_cores"]),
            str(PG["cons_cores"]),
            str(PG["index_cores"]),
            CACTUS_ACTIVATE,
        ] + shlex.split(PG.get("extra_args", ""))
        subprocess.run(cmd, check=True)


rule pangenome_done:
    input:
        rules.cactus_pangenome.output,
    output:
        DONE,
    log:
        f"{LOG}/pangenome_done/pangenome.done.log",
    shell:
        "mkdir -p $(dirname {output}) && touch {output} 2> {log}"
